<?xml version="1.0"?>
<model>
  <name>Lidar 3d v1</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Riccardo Enrico</name>
    <email>riccardo.enrico97@proton.me</email>
  </author>
  <description>
    Generic VLP-16-class 3D scanning lidar: 16 vertical channels over
    +/-15 deg, 1024 horizontal samples over 360 deg, 100 m range, 10 Hz.
    Provides the vertical spread TARE's planning_env needs to extract
    vertical surfaces.
  </description>
</model>
